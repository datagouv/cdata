+    /**
+     * Whether an URL coming from a third-party document (e.g. a GetCapabilities
+     * response) can be used as a link target, i.e. it can't run script.
+     *
+     * @param {String} url - url to check
+     * @return {Boolean} true for http(s) URLs only
+     */
+    isSafeUrl : function (url) {
+        try {
+            var protocol = new URL(url, window.location.href).protocol;
+            return protocol === "http:" || protocol === "https:";
+        } catch (e) {
+            return false;
+        }
     }
 };
 
