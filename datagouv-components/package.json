{
  "name": "@datagouv/components-next",
  "version": "1.4.0",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">= 20.0.0",
    "pnpm": ">= 10.0.0",
    "npm": "use-pnpm-instead",
    "yarn": "use-pnpm-instead"
  },
  "main": "./src/main.ts",
  "exports": {
    ".": "./src/main.ts",
    "./chart": "./src/chart.ts",
    "./assets/*": "./assets/*",
    "./dist/*": "./dist/*"
  },
  "sideEffects": false,
  "files": [
    "assets",
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "run-p typecheck \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "typecheck": "vue-tsc --build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/",
    "css": "tailwindcss -i ./assets/main.css -o ./dist/components.css --minify --optimize",
    "preversion": "pnpm run build && pnpm run css",
    "publish-dev": "pnpm publish --tag dev --access public",
    "publish-stable": "pnpm publish --access public"
  },
  "dependencies": {
    "@floating-ui/vue": "^2.0.1",
    "@headlessui/vue": "^1.7.23",
    "@internationalized/date": "^3.12.4",
    "@remixicon/vue": "^4.9.0",
    "@types/hast": "^3.0.5",
    "@types/leaflet": "^1.9.22",
    "@vueuse/core": "^14.4.0",
    "@vueuse/router": "^14.4.0",
    "chart.js": "^4.5.1",
    "dompurify": "^3.4.15",
    "echarts": "^6.1.0",
    "geopf-extensions-openlayers": "1.0.0-beta.11",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^5.24.0",
    "ofetch": "^1.5.1",
    "ol": "^10.10.0",
    "pdfjs-dist": "^4.10.38",
    "pmtiles": "^4.5.0",
    "popmotion": "^11.0.5",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "reka-ui": "^2.10.4",
    "remark-behead": "^3.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "strip-markdown": "^6.0.0",
